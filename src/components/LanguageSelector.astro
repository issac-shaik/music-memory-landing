---
const languages = [
  { code: 'en', label: 'English', short: 'EN' },
  { code: 'de', label: 'Deutsch', short: 'DE' },
  { code: 'es', label: 'Español', short: 'ES' },
  { code: 'fr', label: 'Français', short: 'FR' },
  { code: 'it', label: 'Italiano', short: 'IT' },
  { code: 'ja', label: '日本語', short: 'JA' },
  { code: 'pt', label: 'Português', short: 'PT' },
  { code: 'zh', label: '简体中文', short: 'ZH' },
] as const

const localePattern = /^\/(de|es|fr|it|ja|pt|zh)(?=\/|$)/
const path = Astro.url.pathname
const match = path.match(localePattern)
const current = match?.[1] ?? 'en'
const unlocalizedPath = path.replace(localePattern, '') || '/'
const basePath =
  unlocalizedPath === '/index.html' ? '/' : unlocalizedPath.replace(/\.html$/, '') || '/'

const localizedHref = (code: string) => {
  if (code === 'en') return basePath
  return `/${code}${basePath === '/' ? '/' : basePath}`
}
---

<details class="language-picker" data-language-picker translate="no">
  <summary aria-label="Choose language" title="Choose language">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
    </svg>
    <span>{languages.find((language) => language.code === current)?.short}</span>
    <svg class="language-chevron" aria-hidden="true" viewBox="0 0 12 8" width="10" height="7">
      <path d="m1 1 5 5 5-5"></path>
    </svg>
  </summary>
  <div class="language-menu" role="menu">
    <p class="language-menu-label">Language</p>
    {languages.map((language) => (
      <a
        href={localizedHref(language.code)}
        role="menuitem"
        lang={language.code}
        aria-current={language.code === current ? 'page' : undefined}
        data-language={language.code}
      >
        <span>{language.label}</span>
        <span class="language-check" aria-hidden="true">{language.code === current ? '✓' : ''}</span>
      </a>
    ))}
  </div>
</details>

<script>
  const picker = document.querySelector('[data-language-picker]')
  if (picker instanceof HTMLDetailsElement) {
    picker.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
      link.addEventListener('click', () => {
        const language = link.dataset.language
        if (language) localStorage.setItem('music-memory-language', language)
      })
    })

    document.addEventListener('click', (event) => {
      if (picker.open && event.target instanceof Node && !picker.contains(event.target)) {
        picker.open = false
      }
    })

    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        picker.open = false
        picker.querySelector('summary')?.focus()
      }
    })
  }
</script>
