  <script>
    // Hero float cards: gentle drift loop, paused while off-screen.
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.float-card'))
    if (cards.length) {
      type Meta = {
        card: HTMLElement
        baseRotate: number
        period: number
        amp: number
        start: number
        visible: boolean
      }
      const metas: Meta[] = cards.map((c, i) => ({
        card: c,
        baseRotate: (Math.random() - 0.5) * 6,
        period: 9000 + i * 1700,
        amp: 4 + (i % 3) * 2,
        start: performance.now() - Math.random() * (9000 + i * 1700),
        visible: false,
      }))

      let raf = 0
      let running = false
      const tick = (now: number) => {
        let any = false
        for (const m of metas) {
          if (!m.visible) continue
          any = true
          const phase = ((now - m.start) % m.period) / m.period
          const y = Math.sin(phase * Math.PI * 2) * m.amp
          const x = Math.cos(phase * Math.PI * 2) * (m.amp * 0.4)
          m.card.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) rotate(${m.baseRotate.toFixed(2)}deg)`
        }
        if (any) {
          raf = requestAnimationFrame(tick)
        } else {
          running = false
        }
      }

      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          const m = metas.find((x) => x.card === e.target)
          if (m) m.visible = e.isIntersecting
        }
        if (!running && metas.some((m) => m.visible)) {
          running = true
          raf = requestAnimationFrame(tick)
        }
      })
      metas.forEach((m) => io.observe(m.card))
    }

    // Story progress rail: highlight steps up to the frame currently in view.
    const progress = document.querySelector('[data-story-progress]')
    const frames = Array.from(document.querySelectorAll<HTMLElement>('.story-wf .story-frame'))
    if (progress && frames.length) {
      const steps = Array.from(progress.querySelectorAll('.step'))
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            const idx = frames.indexOf(e.target as HTMLElement)
            if (idx < 0) continue
            steps.forEach((s, i) => s.classList.toggle('on', i <= idx))
          }
        },
        { threshold: 0.5, rootMargin: '-20% 0px -20% 0px' }
      )
      frames.forEach((f) => io.observe(f))
    }
  </script>
