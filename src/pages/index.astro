---
import BaseLayout from '../layouts/BaseLayout.astro'
import FaqList from '../components/FaqList.astro'
import MemoryThread from '../components/MemoryThread.astro'
import { faqJsonLd } from '../data/faq'
import ComingSoonWaitlist from '../components/react/Waitlist'
import BillingToggle from '../components/react/BillingToggle'
import SongSearchWizard from '../components/react/SongSearchWizard'
const SITE = 'https://musicmemory.app'
const cover = 'https://is1-ssl.mzstatic.com/image/thumb/Music126/v4/dd/50/c7/dd50c790-99ac-d3d0-5ab8-e3891fb8fd52/634904032463.png/300x300bb.jpg'
const appJsonLd = {
  '@context': 'https://schema.org', '@type': 'MobileApplication', '@id': `${SITE}/#app`,
  name: 'Music Memory', applicationCategory: 'LifestyleApplication', operatingSystem: 'iOS, Android', url: SITE,
  description: 'A music journal and song diary. Save songs with dates, places, memories, photos and videos. Coming soon to iOS and Android.',
  screenshot: [`${SITE}/screenshot-journal.png`, `${SITE}/screenshot-entry.png`, `${SITE}/Collections.png`],
  offers: { '@type': 'Offer', price: '49.99', priceCurrency: 'USD', description: 'Annual subscription with a 3-day free trial. Monthly available at 9.99 USD. Prices vary by region.' },
  author: { '@id': `${SITE}/#org` }
}
const stories = [
  { place: 'Portland', date: 'October 2019', text: 'The windows were down even though it was cold. I knew the moment was going to matter.' },
  { place: 'Tokyo', date: 'June 2019', text: 'Walked home in the rain on purpose, just so it could keep playing.' },
  { place: 'Austin', date: 'November 2021', text: 'Drove the long way home just so it would finish.' },
]
---
<BaseLayout canonical="/" structuredData={[appJsonLd, faqJsonLd(SITE)]}>
  <main>
    <section class="home-hero motion-scene" aria-labelledby="hero-title">
      <MemoryThread variant="hero-thread" />
      <div class="page hero-layout">
        <div class="hero-copy">
          <p class="intro-line"><span class="little-spark" aria-hidden="true">✳</span> A music journal for the moments that stay.</p>
          <h1 id="hero-title">Remember where the song takes you.</h1>
          <p class="hero-description">Save the songs that bring a moment back. Add where you were, when it happened, and the details you want to keep.</p>
          <div class="hero-actions"><a class="button" href="#waitlist">Join the waitlist</a><a class="text-link" href="#try-it">Try a memory <span aria-hidden="true">↗</span></a></div>
          <p class="availability">Coming soon to iOS &amp; Android</p>
        </div>
        <div class="memory-composition" aria-label="An illustrative song memory from a drive in Austin">
          <div class="place-stamp"><span class="location-dot" aria-hidden="true"></span> Austin, Texas</div>
          <figure class="drive-print drift-item">
            <img src="/memory-drive.svg" alt="Illustration of a winding road through blue hills at dusk" width="720" height="520" fetchpriority="high" />
            <figcaption>the long way home</figcaption>
          </figure>
          <div class="song-slip"><img src={cover} alt="In Rainbows album artwork" width="64" height="64" /><div translate="no"><strong>Jigsaw Falling Into Place</strong><span>Radiohead</span></div><span class="song-symbol" aria-hidden="true">♫</span></div>
          <div class="memory-note drift-item"><span class="note-date">November 2021</span><p>“Drove the long way home just so it would finish.”</p><svg viewBox="0 0 100 18" aria-hidden="true"><path d="M1 12Q30 1 70 9T98 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></div>
          <span class="sample-caption">A little example of what you can keep.</span>
          <span class="composition-spark" aria-hidden="true">✳</span>
        </div>
      </div>
      <div class="page hero-foot"><span>A song. A place. A piece of your life.</span><a href="#memories">Follow the memory <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="memory-story motion-scene" id="memories" aria-labelledby="story-title">
      <MemoryThread />
      <div class="page">
        <div class="section-intro"><h2 id="story-title">The song is just<br />the beginning.</h2><p>Keep the rest of the moment with it.<br />The place. The feeling. The people just outside the frame.</p></div>
        <ol class="memory-pieces">
          <li><span class="step-label">01 / Find the song</span><div class="song-piece"><img src={cover} alt="In Rainbows album artwork" width="120" height="120" loading="lazy" /><div translate="no"><strong>Jigsaw Falling<br />Into Place</strong><p>Radiohead</p></div></div><p>Search Apple Music’s catalogue, or add a song of your own.</p></li>
          <li><span class="step-label">02 / Place the moment</span><div class="date-piece"><strong>November<br />2021</strong><span><i class="location-dot" aria-hidden="true"></i> Austin, Texas</span></div><p>Give it a date and a place. A whole chapter comes back.</p></li>
          <li><span class="step-label">03 / Keep the details</span><div class="detail-piece"><p>“Drove the long way home just so it would finish.”</p><span>A sentence can be enough.</span></div><p>Add what you remember, with photos or videos to bring it closer.</p></li>
        </ol>
        <p class="example-note">Illustrative memory. Yours will have its own story.</p>
      </div>
    </section>

    <section class="demo-section" aria-label="Try making a song memory">
      <div class="page demo-layout"><div class="demo-intro"><span class="little-spark" aria-hidden="true">✳</span><h2>There’s a song<br />you’re thinking of.</h2><p>Start there. See how a few small details turn it into something you can return to.</p><p class="small-note">This is a browser preview. Your memory and attachments aren’t uploaded or saved to an account.</p></div><div><SongSearchWizard client:visible /><noscript><p>Enable JavaScript to try the song search preview.</p></noscript></div></div>
    </section>

    <section class="product-section page" id="features" aria-labelledby="product-title">
      <div class="section-intro"><h2 id="product-title">A home for your<br />musical memory.</h2><p>For yesterday’s discovery.<br />And the song you’ve carried for years.</p></div>
      <article class="product-chapter journal-chapter">
        <div class="chapter-copy"><span class="chapter-marker" aria-hidden="true">↶</span><h3>Find your<br />way back.</h3><p>Open your journal and travel through the songs of your life. Every cover holds a moment. Every month becomes a chapter.</p><p class="chapter-detail">Keep the date, place, words, and photos together. Come back whenever the song finds you again.</p></div>
        <div class="journal-screens"><div class="screen-orbit" aria-hidden="true"></div><img class="journal-screen" src="/screenshot-journal.webp" alt="Music Memory journal with songs organized by month" width="860" height="1582" loading="lazy" /><img class="entry-screen" src="/screenshot-entry.webp" alt="A song memory with its date, location, story, and photos" width="938" height="1677" loading="lazy" /><span class="screen-caption">Your life, one song at a time.</span></div>
      </article>
      <article class="product-chapter collection-chapter">
        <div class="collection-visual"><img src="/Collections.png" alt="Collections in the Music Memory app" width="868" height="1600" loading="lazy" /><div class="collection-label"><span>An idea for your collection</span><strong>The first<br />apartment.</strong><span>All the songs that made it home.</span></div></div>
        <div class="chapter-copy"><span class="chapter-marker" aria-hidden="true">⊞</span><h3>Keep a chapter<br />together.</h3><p>The first apartment. The summer drives. The people who changed your taste in music. Gather the songs that belong together into collections.</p><p class="chapter-detail">Export a collection to Apple Music as a playlist. Listen to that chapter all over again.</p></div>
      </article>
      <article class="product-chapter privacy-chapter">
        <div class="chapter-copy"><svg class="lock-icon" viewBox="0 0 40 44" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="6" y="19" width="28" height="23" rx="6"/><path d="M12 19V11a8 8 0 0 1 16 0v8M20 28v6"/></svg><h3>Some memories<br />are just for you.</h3><p>Every memory is private by default. When a story feels worth sharing, you choose who gets to see it.</p><p class="chapter-detail">Keep it to yourself, share with followers, or add it to the public feed. The choice belongs to each memory.</p></div>
        <div class="privacy-visual"><img src="/Privacy_toggle.png" alt="Music Memory visibility options: private, followers, or public" width="828" height="1594" loading="lazy" /><span class="privacy-caption">A personal journal.<br />On your terms.</span></div>
      </article>
    </section>

    <section class="shared-section motion-scene" id="community" aria-labelledby="shared-title"><MemoryThread /><div class="page"><div class="shared-heading"><h2 id="shared-title">Same song.<br />Entirely different lives.</h2><p>Discover the moments other people attach to a song.<br />You might find a little of yourself in theirs.</p><div class="shared-song"><img src={cover} alt="" width="44" height="44" loading="lazy" /><span translate="no">Jigsaw Falling Into Place <small>Radiohead</small></span></div></div><div class="shared-memories">{stories.map((story) => <figure><blockquote>“{story.text}”</blockquote><figcaption><span>{story.place}</span><span>{story.date}</span></figcaption></figure>)}</div><p class="example-note">Illustrative memories, not customer testimonials.</p></div></section>

    <section class="page pricing-section" id="pricing" aria-labelledby="pricing-title"><div class="pricing-copy"><h2 id="pricing-title">All your songs.<br />All their stories.</h2><p>One subscription for your growing journal. Unlimited memories, collections, media, and the places that belong to them.</p><p>Start with a 3-day free trial when the app launches. Prices vary by region.</p><div class="pricing-flower" aria-hidden="true">✳</div></div><div class="pricing-widget"><BillingToggle client:visible /></div></section>
    <section class="page faq-section" id="faq" aria-labelledby="faq-title"><div><h2 id="faq-title">A few things<br />you might wonder.</h2><a class="text-link" href="/faq">Read all FAQs <span aria-hidden="true">↗</span></a></div><FaqList /></section>
    <section class="closing-section motion-scene" id="waitlist" aria-labelledby="closing-title"><MemoryThread /><div class="page closing-content"><span class="little-spark" aria-hidden="true">✳</span><h2 id="closing-title">Which song would<br />you save first?</h2><p>Your first memory is already out there.<br />We’ll let you know when it has a home.</p><ComingSoonWaitlist client:visible /><p class="availability">Coming soon to iOS &amp; Android</p><noscript><p>Enable JavaScript to join the waitlist.</p></noscript></div></section>
  </main>
  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
    const scenes = [...document.querySelectorAll<HTMLElement>('.motion-scene')]
    const active = new Set<HTMLElement>()
    let frame = 0
    const update = () => {
      frame = 0
      if (reduced.matches) return
      for (const scene of active) {
        const rect = scene.getBoundingClientRect()
        const progress = Math.max(0, Math.min(1, (innerHeight - rect.top) / (innerHeight + rect.height)))
        scene.style.setProperty('--progress', String(progress))
        scene.style.setProperty('--drift', `${(progress - .5) * 24}px`)
      }
    }
    const schedule = () => { if (!frame && !reduced.matches) frame = requestAnimationFrame(update) }
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          const scene = entry.target as HTMLElement
          if (entry.isIntersecting) active.add(scene)
          else active.delete(scene)
        }
        schedule()
      })
      scenes.forEach(scene => observer.observe(scene))
      window.addEventListener('scroll', schedule, { passive: true })
      window.addEventListener('resize', schedule, { passive: true })
      reduced.addEventListener('change', () => {
        if (reduced.matches) scenes.forEach(scene => { scene.style.removeProperty('--progress'); scene.style.removeProperty('--drift') })
        else schedule()
      })
    }
  </script>
</BaseLayout>
